{
  "manifest_version": 3,
  "name": "浏览器操作追踪器",
  "version": "6.9",
  "description": "侧边栏显示浏览器窗口尺寸和页面操作坐标，支持录制回放",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "tabs",
    "sidePanel",
    "scripting",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开操作追踪器"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["replay-inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}